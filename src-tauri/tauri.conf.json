{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FmOffice Sheets",
  "version": "0.1.0",
  "identifier": "app.fmoffice.sheets",
  "build": { "frontendDist": "../app" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "FmOffice Sheets",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "dragDropEnabled": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "shortDescription": "Fan-made spreadsheet app",
    "category": "Productivity"
  }
}
